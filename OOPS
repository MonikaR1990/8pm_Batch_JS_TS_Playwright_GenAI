class Car
{
    //Properties
    constructor(barnd, color, model, price) //parameterized constructor
    {
        this.barnd = barnd
        this.color = color
        this.model = model
        this.price = price
    }

    //methods
    start()
    {
        console.log("Car Started")
    }
    stop()
    {
        console.log("Car Stopped")
    }
    displayCarDetails()
    {
        console.log(this.barnd)
        console.log(this.color)
        console.log(this.model)
        console.log(this.price)
    }
}

let c1 = new Car("TATA", "White", "ZET8", 800000)
c1.displayCarDetails()


let c2 = new Car("BMW", "Balck", "BMW123", 500000)
c2.displayCarDetails()
c2.start()
c2.stop()
 
